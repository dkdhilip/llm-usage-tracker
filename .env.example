# Copy to .env for local runs outside docker-compose. Compose sets its own values.
# NONE of these are real secrets — generate fresh values for any deployment.

# Deployment context. Leave "development" locally. Set "production" (or "staging")
# on a deployed host — the app then refuses to boot on the dev-default SECRET_KEY.
ENVIRONMENT=development

# Postgres connection. Render/Neon give postgres:// or postgresql://; the app
# rewrites the scheme to the psycopg3 driver automatically.
DATABASE_URL=postgresql+psycopg://llm:llm@localhost:5432/llmtracker

# Signs the session cookie + peppers virtual-key hashes.
SECRET_KEY=dev-secret

# Encrypts each workspace's stored provider keys (Fernet; urlsafe-base64, 32
# bytes). REQUIRED when ENVIRONMENT is production/prod/staging — the app refuses
# to start without it. Empty is fine locally (derived from SECRET_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Redis, for atomic / distributed request-rate limiting (signup, join, Playground). OPTIONAL: leave it
# empty (the default) and the rate limiter uses an in-process fallback - correct for a single instance.
# If it is set but unreachable the limiter also falls back (it fails open); spend caps never use Redis.
#   local run outside docker-compose (compose publishes 6379):  redis://localhost:6379/0
#   inside docker-compose (set for you):                        redis://redis:6379/0
#   hosted, with TLS and a password:  rediss://default:<password>@<host>:6379/0   (placeholder - no real secret)
#   Render Key Value (internal URL, same region):               redis://red-<instance-id>:6379
REDIS_URL=

# Signup + workspace + per-tenant abuse caps.
ALLOW_SIGNUP=true
MAX_USERS=300
SIGNUPS_PER_IP_PER_HOUR=5
JOINS_PER_IP_PER_HOUR=10
MAX_WORKSPACES=200
MAX_MEMBERS_PER_WORKSPACE=25
MAX_KEYS_PER_WORKSPACE=25
MAX_OPEN_INVITES_PER_WORKSPACE=50
INVITE_TTL_DAYS=14
MAX_USAGE_ROWS_PER_WORKSPACE=20000
PLAYGROUND_REQUESTS_PER_HOUR=120
MAX_MODEL_PRICING_PER_WORKSPACE=100

# Live mode: a Workspace Admin attaches the workspace's own provider API key(s)
# (encrypted, shown back as ····last4), each with its own monthly spend cap.
# LIVE_CAP_DEFAULT_USD is the fallback until a provider's cap is set.
ALLOW_LIVE_KEYS=true
LIVE_CAP_DEFAULT_USD=5

# Local dev only: allow the Vite dev server origin. Leave empty in production.
CORS_ORIGINS=http://localhost:5173

# ---- instance-wide provider credentials (optional; a workspace can also attach
# its own key in-app) ----
# A key set here configures that provider for every workspace on this instance.
# With none set, workspaces must attach their own key or their requests 402.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Google AI Studio key — reached via Gemini's OpenAI-compatible endpoint.
GEMINI_API_KEY=

# Seconds to cache a provider liveness check.
PROVIDER_CHECK_TTL=300

# Optional path to a JSON file of extra {provider, model, input, output} price
# entries, merged over the built-in table at startup — price a newly released
# model without a code deploy. Missing/malformed => silently ignored.
MODEL_PRICING_OVERRIDES_PATH=
