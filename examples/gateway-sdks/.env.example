# Copy this file to `.env` (git-ignored) and fill it in. PLACEHOLDERS ONLY — never commit real values.
#
# The ONLY required line. It is the virtual key a manager issued to you in the LLM Usage Tracker
# dashboard (shown only once, when created). Rotating or replacing a key means editing this line —
# nothing else changes.
LLM_GATEWAY_KEY=vk_...your-virtual-key...

# Optional. Omit it to use the hosted gateway. To use a gateway running on your machine instead:
# LLM_GATEWAY_URL=http://127.0.0.1:8000
#
# Never put a real OpenAI / Anthropic / Google key in an application or in this file. Real provider
# credentials belong in the gateway workspace.
